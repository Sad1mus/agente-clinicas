# OpenRouter (proveedor de modelos — API compatible con OpenAI)
# Saca la key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelos GRATIS de OpenRouter (sufijo :free) con buen tool-calling.
# Con ≥$10 de crédito comprado, los :free dan 1000 requests/día (sin gastar el saldo).
# Otras opciones free con tools: z-ai/glm-4.5-air:free, qwen/qwen3-next-80b-a3b-instruct:free,
#   meta-llama/llama-3.3-70b-instruct:free
MODEL=moonshotai/kimi-k2.6:free
MODEL_FALLBACK=openai/gpt-oss-120b:free

# Datos para el ranking de OpenRouter (opcionales)
APP_URL=https://tu-agencia.com
APP_NAME=Agente Clinicas

# Supabase (usa la SERVICE ROLE key, no la anon)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbG...

# Zona horaria para resolver "mañana", "el lunes" y filtrar horarios pasados
TZ=America/Bogota

# Puerto del dashboard web (panel de clientas — incluido en todos los planes)
DASHBOARD_PORT=3000

# URL pública del panel (túnel de Cloudflare o dominio del VPS) — para los links por WhatsApp
DASHBOARD_URL=https://tu-tunel-o-dominio.com
